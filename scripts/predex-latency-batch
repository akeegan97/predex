#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${PREDEX_ENV_FILE:-$ROOT_DIR/.env}"

if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

RUNS="${RUNS:-3}"
DURATION_SECONDS="${DURATION_SECONDS:-600}"
CONFIG_PATH="${CONFIG_PATH:-docs/generated_config.json}"
AUDIT_PATH="${AUDIT_PATH:-predex_audit.jsonl}"
OUTPUT_PREFIX="${OUTPUT_PREFIX:-logs/replay/latency_tick_to_signal_spin}"
SPAN="${SPAN:-tick_to_signal_ns}"
BACKEND="${BACKEND:-matplotlib}"

resolve_path() {
  local p="$1"
  if [[ "$p" = /* ]]; then
    printf '%s\n' "$p"
  else
    printf '%s/%s\n' "$ROOT_DIR" "$p"
  fi
}

CONFIG_PATH_RESOLVED="$(resolve_path "$CONFIG_PATH")"
AUDIT_PATH_RESOLVED="$(resolve_path "$AUDIT_PATH")"
OUTPUT_PREFIX_RESOLVED="$(resolve_path "$OUTPUT_PREFIX")"

if ! [[ "$RUNS" =~ ^[0-9]+$ ]] || [[ "$RUNS" -le 0 ]]; then
  echo "predex-latency-batch: RUNS must be a positive integer (got '$RUNS')" >&2
  exit 1
fi

if ! [[ "$DURATION_SECONDS" =~ ^[0-9]+$ ]] || [[ "$DURATION_SECONDS" -le 0 ]]; then
  echo "predex-latency-batch: DURATION_SECONDS must be a positive integer (got '$DURATION_SECONDS')" >&2
  exit 1
fi

if [[ ! -f "$CONFIG_PATH_RESOLVED" ]]; then
  echo "predex-latency-batch: config not found at '$CONFIG_PATH'" >&2
  exit 1
fi

mkdir -p "$(dirname "$OUTPUT_PREFIX_RESOLVED")"

run_timeout() {
  local seconds="$1"
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout --signal=INT --kill-after=5s "${seconds}s" "$@"
    return $?
  fi
  if command -v gtimeout >/dev/null 2>&1; then
    gtimeout --signal=INT --kill-after=5s "${seconds}s" "$@"
    return $?
  fi
  echo "predex-latency-batch: neither 'timeout' nor 'gtimeout' is available" >&2
  return 1
}

TRADER_CMD=("$ROOT_DIR/scripts/trader_app" --config "$CONFIG_PATH_RESOLVED")

for i in $(seq 1 "$RUNS"); do
  echo "==> Run $i/$RUNS: capturing ${DURATION_SECONDS}s of data"

  rm -f "$AUDIT_PATH_RESOLVED"

  set +e
  run_timeout "$DURATION_SECONDS" "${TRADER_CMD[@]}"
  app_status=$?
  set -e

  if [[ "$app_status" -ne 0 && "$app_status" -ne 124 && "$app_status" -ne 130 ]]; then
    echo "predex-latency-batch: trader_app failed on run $i with status $app_status" >&2
    exit "$app_status"
  fi

  if [[ ! -s "$AUDIT_PATH_RESOLVED" ]]; then
    echo "predex-latency-batch: audit file missing/empty after run $i: $AUDIT_PATH" >&2
    exit 1
  fi

  csv_out="${OUTPUT_PREFIX}_${i}.csv"
  png_prefix="${OUTPUT_PREFIX}_${i}"
  audit_snapshot="${OUTPUT_PREFIX}_${i}.audit.jsonl"

  cp "$AUDIT_PATH_RESOLVED" "$(resolve_path "$audit_snapshot")"

  echo "==> Run $i/$RUNS: building latency outputs"
  "$ROOT_DIR/scripts/predex-replay" latency-histograms \
    --audit "$AUDIT_PATH_RESOLVED" \
    --backend "$BACKEND" \
    --spans "$SPAN" \
    --output-csv "$(resolve_path "$csv_out")" \
    --output-png-prefix "$(resolve_path "$png_prefix")"

done

echo "==> Completed $RUNS run(s)."
echo "CSV outputs: ${OUTPUT_PREFIX}_<run>.csv"
echo "Audit snapshots: ${OUTPUT_PREFIX}_<run>.audit.jsonl"
