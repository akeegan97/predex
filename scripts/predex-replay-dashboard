#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${PREDEX_ENV_FILE:-$ROOT_DIR/.env}"
APP_PATH="$ROOT_DIR/python/src/predex/replay/dashboard.py"
export PYTHONPATH="$ROOT_DIR/python/src${PYTHONPATH:+:$PYTHONPATH}"

if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

if [[ -x "$ROOT_DIR/.venv/bin/streamlit" ]]; then
  exec "$ROOT_DIR/.venv/bin/streamlit" run "$APP_PATH" "$@"
fi

if command -v streamlit >/dev/null 2>&1; then
  exec streamlit run "$APP_PATH" "$@"
fi

echo "predex: streamlit not found. Install replay viz deps with:" >&2
echo "  .venv/bin/pip install '.[replay-viz]'" >&2
exit 1
